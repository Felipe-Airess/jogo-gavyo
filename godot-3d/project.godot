; Teste do Miguel 3D (estilo PS1). Projeto separado do duelo 2D em godot-poc/.
config_version=5

[application]
config/name="GAVIÃO 3D - teste do Miguel"
run/main_scene="res://bench.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]
window/size/viewport_width=426
window/size/viewport_height=240
window/size/window_width_override=1278
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=6

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.02, 0.025, 0.03, 1)

[input_devices]
pointing/emulate_mouse_from_touch=false
